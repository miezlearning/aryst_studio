rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Video hero yang diunggah dashboard admin. Model berbagi tautan:
    // siapa pun boleh membaca/menulis file studio, dibatasi tipe video
    // dan ukuran maksimum 30 MB (sama dengan batas UI).
    match /studio/{file=**} {
      allow read: if true;
      allow write: if request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if true;
    }
  }
}
