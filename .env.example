# Kunci API Google Drive v3 untuk memuat foto (opsional;
# bisa juga diisi lewat Dashboard Admin -> Pengaturan).
# VITE_GOOGLE_API_KEY=AIzaSy...

# Konfigurasi Firebase Web App dalam JSON satu baris, untuk sinkronisasi
# cloud (Firestore). Ambil dari Firebase Console -> Pengaturan proyek ->
# Aplikasi saya -> SDK web -> konfigurasi. Konfigurasi web aman dipublikasikan;
# keamanan datanya diatur oleh firestore.rules.
# VITE_FIREBASE_CONFIG={"apiKey":"AIza...","authDomain":"contoh.firebaseapp.com","projectId":"contoh","storageBucket":"contoh.appspot.com","messagingSenderId":"1234567890","appId":"1:1234567890:web:abc"}
